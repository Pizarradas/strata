+  .syx-embed--8by5 {
+    padding-block-end: 62.5%;
+  }
+  .syx-embed--3by2 {
+    padding-block-end: 66.66%;
+  }
+  .syx-embed--4by3 {
+    padding-block-end: 75%;
+  }
+  .syx-embed--1by1 {
+    padding-block-end: 100%;
+  }
+  .syx-map {
+    position: relative;
+    height: 0;
+    overflow: hidden;
+  }
+  .syx-map__iframe {
+    position: absolute;
+    inset-block-start: 0;
+    inset-inline-start: 0;
+    height: 100%;
+    width: 100%;
+    border: 0;
+  }
+  .syx-map--16by9 {
+    padding-block-end: 56.25%;
+  }
+  .syx-map--8by5 {
+    padding-block-end: 62.5%;
+  }
+  .syx-map--4by3 {
+    padding-block-end: 75%;
+  }
+  .syx-map--3by2 {
+    padding-block-end: 66.66%;
+  }
+  .syx-map--h100 {
+    padding-block-end: 100vh;
+  }
+  .syx-obj-cover {
+    object-fit: cover;
+  }
+  .syx-obj-contain {
+    object-fit: contain;
+  }
+  .syx-obj-fill {
+    object-fit: fill;
+  }
+  .syx-obj-none {
+    object-fit: none;
+  }
+  .syx-obj-scale-down {
+    object-fit: scale-down;
+  }
+  .syx-obj-center {
+    object-position: center;
+  }
+  .syx-obj-top {
+    object-position: top;
+  }
+  .syx-obj-bottom {
+    object-position: bottom;
+  }
+}
+@layer syx.utilities {
+  .syx-sr-only {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+    border: 0;
+  }
+  .syx-sr-only-focusable {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+    border: 0;
+  }
+  .syx-sr-only-focusable:focus, .syx-sr-only-focusable:focus-within {
+    position: static;
+    width: auto;
+    height: auto;
+    padding: 0;
+    margin: 0;
+    overflow: visible;
+    clip: auto;
+    white-space: normal;
+  }
+  .syx-skip-link {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+    border: 0;
+  }
+  .syx-skip-link:focus {
+    position: fixed;
+    inset-block-start: var(--semantic-space-layout-sm);
+    inset-inline-start: var(--semantic-space-layout-sm);
+    z-index: var(--semantic-z-index-skip-link, 9999);
+    padding: var(--semantic-space-component-sm) var(--semantic-space-component-md);
+    background: var(--semantic-color-primary);
+    color: var(--semantic-color-on-primary);
+    border-radius: var(--semantic-border-radius-default);
+    font-size: var(--semantic-font-size-body-small);
+    font-family: var(--semantic-font-family-primary-bold);
+    font-weight: var(--semantic-font-weight-primary-bold);
+    text-decoration: none;
+    box-shadow: var(--semantic-shadow-md);
+    width: auto;
+    height: auto;
+    overflow: visible;
+    clip: auto;
+    white-space: normal;
+  }
+  @media (prefers-reduced-motion: reduce) {
+    .syx-motion-safe {
+      animation: none;
+      transition: none;
+    }
+  }
+}
