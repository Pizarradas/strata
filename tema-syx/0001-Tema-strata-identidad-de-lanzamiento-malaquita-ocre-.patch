diff --git a/scss/styles-theme-strata.scss b/scss/styles-theme-strata.scss
new file mode 100644
index 0000000..0ac1370
--- /dev/null
+++ b/scss/styles-theme-strata.scss
@@ -0,0 +1,10 @@
+// SYX — Entry point: strata (lanzamiento de un teléfono modular)
+// ================================================
+// Compiles to: css/styles-theme-strata.css
+// ================================================
+
+// THEME SETUP (tokens + reset + helpers + atoms + molecules + organisms)
+@use 'themes/strata/setup';
+
+// UTILITIES (text, display, spacing utility classes)
+@use 'utilities/index' as *;
diff --git a/scss/themes/strata/_setup.scss b/scss/themes/strata/_setup.scss
new file mode 100644
index 0000000..088e471
--- /dev/null
+++ b/scss/themes/strata/_setup.scss
@@ -0,0 +1,37 @@
+// ================================================
+// TEMA STRATA — CABLEADO
+// ================================================
+// Cópialo con la carpeta y cambia «template» por el nombre del tema: nada
+// más. La lista de componentes vive en _shared/_bundle-full.scss y la de
+// fuentes en el _theme.scss de este tema (theme-x-fonts).
+// ================================================
+
+// CORE
+@use '../_base/universal' as *;
+@use '../_shared/core' as *;
+@use '../_shared/bundle-full' as *;
+// @use '../../site/bundle-site' as *; // CAPA DEL SITIO — ver abajo
+@use 'theme' as *;
+
+// THEME TOKENS
+// ================================================
+@include universal-values();
+@include theme-strata();
+
+// FONTS (declared once in _theme.scss)
+// ================================================
+@include theme-strata-fonts();
+
+// CORE (reset + elements + helpers + grid)
+// ================================================
+@include syx-core(strata);
+
+// FULL SYSTEM BUNDLE (every atom, molecule, organism)
+// ================================================
+@include syx-bundle-full(strata);
+
+// CAPA DEL SITIO — solo la llevan los temas que pintan las páginas de SYX
+// (home.html, docs.html…). Un tema para un producto NO: es mobiliario del
+// sitio. Para pintarlo, descomenta esta línea y el @use de arriba.
+// ================================================
+// @include syx-bundle-site(template);
diff --git a/scss/themes/strata/_theme.scss b/scss/themes/strata/_theme.scss
new file mode 100644
index 0000000..03d7835
--- /dev/null
+++ b/scss/themes/strata/_theme.scss
@@ -0,0 +1,156 @@
+// ================================================
+// TEMA STRATA — identidad de lanzamiento de un teléfono modular
+// ================================================
+// Nace de la plantilla (scss/themes/_template): misma estructura y mismo
+// contrato. La idea de marca son los estratos minerales: cada capa del
+// teléfono es una capa de roca. Malaquita (primario), ocre (acento), óxido
+// (terciario) sobre piedra en claro y basalto en oscuro. Forma de pieza
+// mecanizada: radios pequeños y precisos.
+//
+// Tipografía propia (fonts/strata/, OFL): Archivo variable (peso y anchura)
+// para titulares, Instrument Sans para el texto; DM Mono, de SYX, para cifras
+// y rótulos técnicos.
+// ================================================
+
+@use '../../abstracts/index' as *;
+
+@mixin theme-strata {
+  :root {
+    // ================================================
+    // 1 · MARCA
+    // ================================================
+    // Primitivos propios, nombrados por su papel en la marca (los del sistema
+    // quedan intactos). Solo los leen los roles de abajo.
+    --primitive-color-strata-malachite-300: oklch(0.8 0.1 172); // malaquita clara: primario en oscuro
+    --primitive-color-strata-malachite-400: oklch(0.72 0.11 172);
+    --primitive-color-strata-malachite-600: oklch(0.47 0.1 172); // malaquita: el primario
+    --primitive-color-strata-malachite-700: oklch(0.4 0.09 172);
+    --primitive-color-strata-ochre-500: oklch(0.8 0.14 80); // ocre: el acento
+    --primitive-color-strata-ochre-600: oklch(0.73 0.15 72);
+    --primitive-color-strata-rust-600: oklch(0.55 0.15 40); // óxido
+    --primitive-color-strata-stone-50: oklch(0.976 0.005 140); // piedra: fondos claros
+    --primitive-color-strata-stone-100: oklch(0.948 0.008 140);
+    --primitive-color-strata-stone-200: oklch(0.905 0.011 145);
+    --primitive-color-strata-basalt-950: oklch(0.165 0.012 170); // basalto: fondos oscuros
+    --primitive-color-strata-basalt-900: oklch(0.2 0.014 170);
+    --primitive-color-strata-basalt-850: oklch(0.245 0.016 170);
+
+    // Unidad de espacio: todo el ritmo del sistema son múltiplos de ella.
+    --primitive-space-base: 0.5rem;
+
+    // ================================================
+    // 2 · ROLES DE MARCA
+    // ================================================
+    --semantic-color-primary: var(--primitive-color-strata-malachite-600);
+    --semantic-color-secondary: var(--primitive-color-strata-ochre-500);
+    --semantic-color-tertiary: var(--primitive-color-strata-rust-600);
+    --semantic-color-state-hover-primary: var(--primitive-color-strata-malachite-700);
+    --semantic-color-state-hover-secondary: var(--primitive-color-strata-ochre-600);
+
+    // Tinta sobre cada relleno (check:contraste dice cuál pasa 4,5:1).
+    --semantic-color-on-secondary: var(--semantic-color-ink-dark);
+    --semantic-color-on-tertiary: var(--semantic-color-ink-light);
+    --semantic-color-on-quaternary: var(--semantic-color-ink-dark);
+    --semantic-color-on-quinary: var(--semantic-color-ink-dark);
+    --semantic-color-on-state-hover-secondary: var(--semantic-color-ink-dark);
+    --semantic-color-on-state-hover-tertiary: var(--semantic-color-ink-dark); // el óxido oscurecido pide tinta oscura (check:contraste)
+    --semantic-color-on-state-hover-quaternary: var(--semantic-color-ink-dark);
+
+    // Superficies de piedra en vez de los neutros del sistema, y el basalto
+    // como superficie de énfasis.
+    --semantic-color-bg-primary: var(--primitive-color-strata-stone-50);
+    --semantic-color-bg-secondary: var(--primitive-color-strata-stone-100);
+    --semantic-color-bg-tertiary: var(--primitive-color-strata-stone-200);
+    --semantic-color-bg-emphasis: var(--primitive-color-strata-basalt-900);
+
+    // ================================================
+    // 3 · TEXTO
+    // ================================================
+    --semantic-color-text-primary: oklch(0.21 0.016 170);
+    --semantic-color-text-secondary: oklch(0.44 0.02 170);
+    --semantic-color-text-tertiary: oklch(0.5 0.02 170);
+
+    // ================================================
+    // 4 · FORMA
+    // ================================================
+    --semantic-border-radius-sm: 0.125rem;
+    --semantic-border-radius-default: 0.25rem;
+    --semantic-border-radius-lg: 0.5rem;
+    --theme-radius: var(--semantic-border-radius-default);
+    --layout-max-width: calc(170 * var(--primitive-space-base));
+    --layout-pad-1: var(--primitive-space-2); // margen lateral del grid en móvil: 16 px, no 8
+
+    // ================================================
+    // 5 · TIPOGRAFÍA
+    // ================================================
+    --semantic-font-family-primary: "Instrument Sans", Arial, sans-serif;
+    --semantic-font-family-primary-bold: var(--semantic-font-family-primary);
+    --semantic-font-family-heading: "Archivo", "Arial Black", Arial, sans-serif;
+    --semantic-font-family-heading-md: var(--semantic-font-family-heading);
+    --semantic-font-family-mono: "DM Mono", "DM Mono Fallback", "Courier New", monospace;
+
+    // ================================================
+    // 6 · ICONOS
+    // ================================================
+    --icon-arrow-default: var(--lc-icon-chevron-right);
+    --icon-arrow-double: var(--lc-icon-chevrons-right);
+    --icon-content-bars: var(--lc-icon-menu);
+    --icon-rrss-email: var(--lc-icon-mail);
+    --icon-user-interface-cancel: var(--lc-icon-x);
+    --icon-user-interface-exclamation-mark: var(--lc-icon-warning);
+    --icon-user-interface-home: var(--lc-icon-home);
+    --icon-user-interface-tick: var(--lc-icon-check);
+  }
+
+  // ================================================
+  // 7 · MODO OSCURO — dos entradas, las dos con dark-mode-tokens()
+  // ================================================
+  // Basalto en vez del gris del sistema; la malaquita sube para leerse.
+  @media (prefers-color-scheme: dark) {
+    :root:not([data-theme="light"]) {
+      @include dark-mode-tokens();
+      --semantic-color-primary: var(--primitive-color-strata-malachite-300);
+      --semantic-color-on-primary: var(--semantic-color-ink-dark);
+      --semantic-color-state-hover-primary: var(--primitive-color-strata-malachite-400);
+      --semantic-color-bg-primary: var(--primitive-color-strata-basalt-950);
+      --semantic-color-bg-secondary: var(--primitive-color-strata-basalt-900);
+      --semantic-color-bg-tertiary: var(--primitive-color-strata-basalt-850);
+      --semantic-color-bg-emphasis: var(--primitive-color-strata-basalt-850);
+    }
+  }
+
+  :root[data-theme="dark"] {
+    @include dark-mode-tokens();
+    --semantic-color-primary: var(--primitive-color-strata-malachite-300);
+    --semantic-color-on-primary: var(--semantic-color-ink-dark);
+    --semantic-color-state-hover-primary: var(--primitive-color-strata-malachite-400);
+    --semantic-color-bg-primary: var(--primitive-color-strata-basalt-950);
+    --semantic-color-bg-secondary: var(--primitive-color-strata-basalt-900);
+    --semantic-color-bg-tertiary: var(--primitive-color-strata-basalt-850);
+    --semantic-color-bg-emphasis: var(--primitive-color-strata-basalt-850);
+  }
+
+  :root[data-theme="light"] {
+    color-scheme: light;
+  }
+}
+
+// ================================================
+// 8 · FUENTES
+// ================================================
+// Archivo e Instrument Sans son variables (archivos «standard» de Fontsource,
+// con ejes de peso y anchura) y viven en fonts/strata/. Archivo declara su
+// rango de anchura para que los titulares de la app puedan ensancharla.
+// DM Mono la trae SYX.
+@mixin theme-strata-fonts {
+  @font-face {
+    font-family: "Archivo";
+    src: url("#{$fonts-path}/strata/Archivo-Variable.woff2") format("woff2");
+    font-weight: 100 900;
+    font-stretch: 62% 125%;
+    font-style: normal;
+    font-display: swap;
+  }
+  @include font-family("Instrument Sans", "#{$fonts-path}/strata/InstrumentSans-Variable", 400 700, normal);
+  @include syx-font("DM Mono", 400);
+}
-- 
2.43.0

